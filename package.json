{
  "name": "tack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted, multi-user kanban board with first-class agent (MCP) access",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "node --watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "express": "5.3.0",
    "multer": "2.5.0"
  },
  "devDependencies": {
    "@hello-pangea/dnd": "18.0.1",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "dompurify": "3.4.17",
    "marked": "18.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
